# Local development values only. Change the password before any shared deployment.
# Optional Compose host ports (use alternatives if another app occupies these).
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_DB=agentreadiness
POSTGRES_USER=agentreadiness
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql+psycopg://agentreadiness:local-development-only@localhost:5432/agentreadiness
CORS_ORIGINS=["http://localhost:3000"]
# Next.js proxies same-origin /api/v1 requests to this address.
BACKEND_URL=http://localhost:8000

# Bounded website crawling (per scan).
CRAWL_MAX_PAGES=20
CRAWL_MAX_DEPTH=3
CRAWL_REQUEST_TIMEOUT=10
CRAWL_MAX_REDIRECTS=5
CRAWL_SITEMAP_ENTRIES=500
CRAWL_SITEMAP_DEPTH=3
CRAWL_HTML_BYTES=2097152
CRAWL_SITEMAP_BYTES=2097152
CRAWL_CONCURRENCY=3
CRAWL_DURATION=300
CRAWL_USER_AGENT=AgentReadinessBot/0.1
CRAWL_ALLOW_SUBDOMAINS=false

# Open-weight browser agent; never put credentials in source control.
HF_TOKEN=
# HF_TOKENS is accepted for compatibility; only the first entry is used.
AGENT_LLM_PROVIDER=osaurus
AGENT_MODEL=raptor-0.6-4b-jang_6m
# Docker Desktop reaches the Mac host using host.docker.internal. For native
# backend development, use http://127.0.0.1:1337/v1 instead.
AGENT_LLM_BASE_URL=http://host.docker.internal:1337/v1
AGENT_LLM_TIMEOUT=60
# Required only if Osaurus network exposure is enabled with an access key.
OSAURUS_API_KEY=
# Hugging Face fallback: set AGENT_LLM_PROVIDER=huggingface,
# AGENT_MODEL=Qwen/Qwen3-4B-Instruct-2507, AGENT_LLM_MODE=hosted,
# AGENT_LLM_BASE_URL=https://router.huggingface.co/v1 and HF_TOKEN.
AGENT_LLM_MODE=local
AGENT_LLM_RETRIES=2
AGENT_STRUCTURED_OUTPUT=false
AGENT_MAX_OUTPUT_TOKENS=700
AGENT_MAX_STEPS=15
AGENT_DURATION=90
AGENT_INVALID_LIMIT=3
AGENT_OBSERVATION_CHARS=12000
AGENT_MAX_ELEMENTS=150
AGENT_REQUEST_LIMIT=150
AGENT_MAX_REDIRECTS=5
AGENT_SCREENSHOT_DIR=./artifacts/agent
AGENT_SCREENSHOTS=true
# Optional: set only when Chromium is installed at a non-default path.
AGENT_BROWSER_EXECUTABLE=

# Automatic post-static-scan agent stage and resource policy.
AGENT_PIPELINE_ENABLED=false
AGENT_RUNS_PER_TASK=2
AGENT_FREE_LIMITS_ENABLED=true
AGENT_FREE_TASK_LIMIT=2
AGENT_FREE_RUNS_PER_TASK=1
AGENT_TOKEN_BUDGET=32768
AGENT_ACTION_DELAY=1
AGENT_JUDGE_ENABLED=true
AGENT_SCORE_WEIGHT=0.45
# Optional provider pricing, USD per million input/output tokens.
AGENT_INPUT_COST_PER_MILLION=
AGENT_OUTPUT_COST_PER_MILLION=
AGENT_STAGE_DURATION=600
AGENT_MAX_ACTIVE=2

# Anonymous admission. Forwarded client IPs are ignored unless the direct peer
# is inside this explicitly configured, trusted proxy CIDR list.
AGENT_IP_WINDOW_SECONDS=3600
AGENT_IP_SCAN_LIMIT=10
AGENT_IP_TASK_LIMIT=20
AGENT_TRUSTED_PROXY_CIDRS=[]

# Deterministic audit/report stage; remains independent of model inference.
CRAWL_MIN_DELAY=0.1
SCAN_DURATION=120
SCAN_MAX_ACTIVE=2
SCAN_QUEUE_LIMIT=30
SCAN_QUEUE_WAIT=600
AUDIT_RENDER_PAGES=3
AUDIT_RENDER_TIMEOUT=8
AUDIT_BROWSER_ENABLED=true
# Bounded read-only discovery validation and one missing-path probe; no LLM.
AUDIT_RESOURCE_LIMIT=5
AUDIT_DIAGNOSTICS_TIMEOUT=15
AUDIT_MISSING_PATH_ENABLED=true
REPORT_SHARE_DAYS=7

# Customer launch: keep enabled on any publicly accessible deployment.
CUSTOMER_MODE_ENABLED=true
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
VERIFICATION_SECRET=
# true on HTTPS production; false ONLY for local HTTP development.
VERIFICATION_COOKIE_SECURE=true
PUBLIC_SITE_URL=http://localhost:3000
# Gmail app password requires Google 2-Step Verification. Never use your main password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_FROM=
SMTP_PASSWORD=
# Stripe hosted Checkout. Fixed one-time USD 19, no client-supplied price.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_MODE=false
PAID_REPORT_DAYS=365

# Optional explicit OTP/payment skip buttons. Keep disabled in production.
# Requires development + localhost PUBLIC_SITE_URL + Stripe live mode off.
# DEV_ACCESS_EMAIL is an input hint; local dev accepts any valid email.
APP_ENVIRONMENT=production
DEV_EMAIL_SHORTCUT_ENABLED=false
DEV_ACCESS_EMAIL=

# Edge router (docs/agentlane-mvp.md). Private origins are for the local demo store only.
EDGE_PORT=8080
DEMO_STORE_PORT=4000
EDGE_ALLOW_PRIVATE_ORIGINS=true
EDGE_UPSTREAM_TIMEOUT=30
# Optional BigQuery copy of the agent request log on Google Cloud (docs/deploy-cloud-run.md).
# EDGE_BIGQUERY_TABLE=project.edge_logs.agent_requests

# Gemini (docs/agentlane-mvp.md). Variant extraction and labeling use the
# OpenAI-compatible endpoint; Computer Use (phase 4) uses the native API.
# AGENT_LLM_PROVIDER=gemini
# AGENT_MODEL=gemini-3.8-flash
# AGENT_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=
VARIANT_MAX_PAGES=50
# Owner dashboard (phase 3): a long random token; the dashboard API is off when empty.
EDGE_DASHBOARD_TOKEN=
QA_MODEL=gemini-3.8-flash
# Jobs worker (dashboard-started builds, labeling, QA). Compose sets local values
# (http://{host}:8080 and MAP *.localhost edge); production uses https://{host}.
# QA_BASE_URL_TEMPLATE=https://{host}
# DEV_BROWSER_HOST_RULES=
