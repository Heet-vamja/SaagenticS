# Local development values only. Change the password before any shared deployment.
POSTGRES_DB=agentreadiness
POSTGRES_USER=agentreadiness
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql+psycopg://agentreadiness:local-development-only@localhost:5432/agentreadiness
CORS_ORIGINS=["http://localhost:3000"]
# Next.js proxies same-origin /api/v1 requests to this address.
BACKEND_URL=http://localhost:8000
