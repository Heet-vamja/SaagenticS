# Local development values only. Change the password before any shared deployment.
# Optional Compose host ports (use alternatives if another app occupies these).
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_DB=agentreadiness
POSTGRES_USER=agentreadiness
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql+psycopg://agentreadiness:local-development-only@localhost:5432/agentreadiness
CORS_ORIGINS=["http://localhost:3000"]
# Next.js proxies same-origin /api/v1 requests to this address.
BACKEND_URL=http://localhost:8000

# Bounded website crawling (per scan).
CRAWL_MAX_PAGES=20
CRAWL_MAX_DEPTH=3
CRAWL_REQUEST_TIMEOUT=10
CRAWL_MAX_REDIRECTS=5
CRAWL_SITEMAP_ENTRIES=500
CRAWL_SITEMAP_DEPTH=3
CRAWL_HTML_BYTES=2097152
CRAWL_SITEMAP_BYTES=2097152
CRAWL_CONCURRENCY=3
CRAWL_DURATION=300
CRAWL_USER_AGENT=AgentReadinessBot/0.1
CRAWL_ALLOW_SUBDOMAINS=false

# Open-weight browser agent; never put credentials in source control.
HF_TOKEN=
# HF_TOKENS is accepted for compatibility; only the first entry is used.
AGENT_MODEL=Qwen/Qwen3-4B-Instruct-2507
AGENT_LLM_MODE=hosted
AGENT_LLM_BASE_URL=https://router.huggingface.co/v1
AGENT_LLM_TIMEOUT=25
AGENT_LLM_RETRIES=2
AGENT_STRUCTURED_OUTPUT=false
AGENT_MAX_OUTPUT_TOKENS=700
AGENT_MAX_STEPS=15
AGENT_DURATION=90
AGENT_INVALID_LIMIT=3
AGENT_OBSERVATION_CHARS=12000
AGENT_MAX_ELEMENTS=150
AGENT_REQUEST_LIMIT=150
AGENT_MAX_REDIRECTS=5
AGENT_SCREENSHOT_DIR=./artifacts/agent
AGENT_SCREENSHOTS=true
# Optional: set only when Chromium is installed at a non-default path.
AGENT_BROWSER_EXECUTABLE=

# Automatic post-static-scan agent stage and resource policy.
AGENT_PIPELINE_ENABLED=true
AGENT_RUNS_PER_TASK=2
AGENT_FREE_LIMITS_ENABLED=true
AGENT_FREE_TASK_LIMIT=2
AGENT_FREE_RUNS_PER_TASK=1
AGENT_TOKEN_BUDGET=32768
AGENT_ACTION_DELAY=1
AGENT_JUDGE_ENABLED=true
AGENT_SCORE_WEIGHT=0.45
# Optional provider pricing, USD per million input/output tokens.
AGENT_INPUT_COST_PER_MILLION=
AGENT_OUTPUT_COST_PER_MILLION=
AGENT_STAGE_DURATION=600
AGENT_MAX_ACTIVE=2

# Anonymous admission. Forwarded client IPs are ignored unless the direct peer
# is inside this explicitly configured, trusted proxy CIDR list.
AGENT_IP_WINDOW_SECONDS=3600
AGENT_IP_SCAN_LIMIT=10
AGENT_IP_TASK_LIMIT=20
AGENT_TRUSTED_PROXY_CIDRS=[]

# Deterministic audit/report stage; remains independent of model inference.
CRAWL_MIN_DELAY=0.1
SCAN_DURATION=120
SCAN_MAX_ACTIVE=2
SCAN_QUEUE_LIMIT=30
SCAN_QUEUE_WAIT=600
AUDIT_RENDER_PAGES=3
AUDIT_RENDER_TIMEOUT=8
AUDIT_BROWSER_ENABLED=true
REPORT_SHARE_DAYS=7
